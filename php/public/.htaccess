Options -Indexes
RewriteEngine On
RewriteRule ^api(?:/(.*))?$ api.php [L,QSA]

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
Header always set Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'"
</IfModule>
